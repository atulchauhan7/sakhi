<style>
:root {
--color-accent: {{ settings.accent_color }};
--color-accent-dark: {{ settings.accent_color_dark | default: settings.accent_color | color_darken: 15 }};
--color-accent-rgb: {{ settings.accent_color | color_extract: 'red' }}, {{ settings.accent_color | color_extract: 'green' }}, {{ settings.accent_color | color_extract: 'blue' }};
--color-text: {{ settings.text_color | default: '#1a1a1a' }};
--color-text-muted: {{ settings.text_muted_color | default: '#888888' }};
--color-heading: {{ settings.heading_color | default: '#1a1a1a' }};
--color-background: {{ settings.background_color | default: '#ffffff' }};
--color-surface: {{ settings.surface_color | default: '#fafafa' }};
--color-border: {{ settings.border_color | default: '#d5d5d5' }};
--font-heading: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
--font-body: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
--border-radius: {{ settings.border_radius | default: 0 }}px;
--container-width: {{ settings.container_width | default: '1440px' }};
--grid-gutter: {{ settings.grid_gutter | default: '28px' }};
--section-spacing: {{ settings.section_spacing | default: 5 }}px;
--color-header-bg: {{ settings.header_bg_color | default: '#ffffff' }};
--color-header-text: {{ settings.header_text_color | default: '#e12d2d' }};
--ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
--ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
--duration-fast: 0.2s;
--duration-md: 0.5s;
--duration-lg: 0.8s;

/* === Design system tokens (redesign 2026) === */
/* Tonal accent steps derived from the brand accent */
--color-accent-soft: rgba(var(--color-accent-rgb), 0.10);
--color-accent-softer: rgba(var(--color-accent-rgb), 0.05);
--color-accent-border: rgba(var(--color-accent-rgb), 0.22);

/* Fluid type scale (1.20 minor-third, clamped for mobile-first) */
--fs-xs: clamp(0.68rem, 0.65rem + 0.15vw, 0.74rem);
--fs-sm: clamp(0.78rem, 0.75rem + 0.18vw, 0.86rem);
--fs-base: clamp(0.9rem, 0.86rem + 0.2vw, 1rem);
--fs-md: clamp(1.05rem, 1rem + 0.35vw, 1.2rem);
--fs-lg: clamp(1.25rem, 1.1rem + 0.7vw, 1.6rem);
--fs-xl: clamp(1.6rem, 1.3rem + 1.4vw, 2.4rem);
--fs-2xl: clamp(2rem, 1.5rem + 2.4vw, 3.4rem);
--fs-3xl: clamp(2.4rem, 1.7rem + 3.4vw, 4.4rem);

/* Spacing scale (8px base) */
--sp-1: 4px;  --sp-2: 8px;  --sp-3: 12px; --sp-4: 16px;
--sp-5: 24px; --sp-6: 32px; --sp-7: 48px; --sp-8: 64px; --sp-9: 96px;
/* Vertical rhythm between sections — fluid */
--section-gap: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);

/* Radius scale */
--radius-sm: 6px;
--radius-md: 10px;
--radius-lg: 16px;
--radius-xl: 24px;
--radius-pill: 999px;

/* Elevation scale — soft, modern, layered */
--shadow-xs: 0 1px 2px rgba(17,17,17,0.05);
--shadow-sm: 0 2px 8px rgba(17,17,17,0.06);
--shadow-md: 0 8px 24px rgba(17,17,17,0.08);
--shadow-lg: 0 18px 48px rgba(17,17,17,0.12);
--shadow-accent: 0 12px 32px rgba(var(--color-accent-rgb),0.22);
}
@media(max-width:768px){
  :root{--grid-gutter:16px}
}
@media(max-width:480px){
  :root{--grid-gutter:12px}
}
</style>